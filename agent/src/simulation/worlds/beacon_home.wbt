# ==============================================================================
# SMART HOME SUPERVISOR ROBOT (REFINED CAMERAS + MOTION & DAYLIGHT SENSORS)
# ==============================================================================
Robot {
  name "smart_home_controller"
  controller "smart_home_controller"
  supervisor TRUE
  children [
    # 1. Living Room Camera: NE corner of Living Room looking SW across sofas, coffee table & dining area (22 deg downward tilt)
    Camera {
      translation -4.2 -0.5 2.15
      rotation -0.072 0.175 -0.982 2.38
      name "Living Room Camera"
      fieldOfView 1.15
      width 640
      height 480
    }
    # 2. Kitchen Camera: SE corner of Kitchen looking NW across breakfast island, fridge, sink & stove (22 deg downward tilt)
    Camera {
      translation -0.4 -4.6 2.15
      rotation -0.175 0.072 0.982 2.38
      name "Kitchen Camera"
      fieldOfView 1.15
      width 640
      height 480
    }
    # 3. Bedroom Camera: NE corner of Master Bedroom looking SW at the bed, armchair & window (22 deg downward tilt)
    Camera {
      translation -0.35 -8.8 2.15
      rotation -0.072 0.175 -0.982 2.38
      name "Bedroom Camera"
      fieldOfView 1.15
      width 640
      height 480
    }
    # 4. Front Door Camera: Inside Foyer looking East toward the Front Entrance Door & Hallway (20 deg downward tilt)
    Camera {
      translation -3.1 -7.5 2.1
      rotation 0 1 0 0.35
      name "Front Door Camera"
      fieldOfView 1.1
      width 640
      height 480
    }
    # 5. Driveway Camera: Mounted above Garage Door looking South across Entrance Forecourt & Driveway Gate (22 deg downward tilt)
    Camera {
      translation 2.1 -5.65 2.15
      rotation -0.138 0.138 -0.981 1.60
      name "Driveway Camera"
      fieldOfView 1.15
      width 640
      height 480
    }
    # 6. Backyard Patio Camera: North end of Patio looking South at the BBQ Grill & Patio Sofa Lounge (22 deg downward tilt)
    Camera {
      translation -11.2 -3.7 2.1
      rotation -0.138 0.138 -0.981 1.60
      name "Backyard Patio Camera"
      fieldOfView 1.15
      width 640
      height 480
    }
    # 7. Rover Mast Camera: First-person view at the rover's dock/corridor vantage point
    DEF ROVER_MAST_CAMERA Camera {
      translation -3.1 -7.22 0.22
      rotation 0 0 1 1.5708
      name "Rover Mast Camera"
      fieldOfView 1.15
      width 640
      height 480
    }
    # Motion / Presence Distance Sensors
    DistanceSensor {
      translation 0.2 -7.49 1.1
      rotation 0 0 1 0
      name "Front Porch Motion Sensor"
      lookupTable [ 0 0 0, 4.0 1000 0 ]
    }
    DistanceSensor {
      translation -6.0 -2.5 1.2
      rotation 0 0 1 0
      name "Living Room Motion Sensor"
      lookupTable [ 0 0 0, 5.0 1000 0 ]
    }
    DistanceSensor {
      translation -3.5 -7.5 1.2
      rotation 0 0 1 3.14159
      name "Hallway Motion Sensor"
      lookupTable [ 0 0 0, 5.0 1000 0 ]
    }
    DistanceSensor {
      translation 2.1 -9.2 1.0
      rotation 0 0 1 1.5708
      name "Driveway Gate Motion Sensor"
      lookupTable [ 0 0 0, 4.0 1000 0 ]
    }
    # Roof Ambient Daylight Sensor
    LightSensor {
      translation -3.5 -5.0 2.6
      rotation 0 -1 0 1.5708
      name "Exterior Daylight Sensor"
    }
  ]
}
