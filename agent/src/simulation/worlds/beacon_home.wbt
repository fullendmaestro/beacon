# ==============================================================================
# ATTACHED GARAGE & FRONT ENTRANCE COURTYARD (FLUSH WITH EAST WALL x=0)
# ==============================================================================
DEF EXTERIOR_COURTYARD Group {
  children [
    # Garage Floor (x=0 to 4.2, y=0 to -5.6)
    Solid {
      translation 2.1 -2.8 0
      children [
        Shape {
          appearance CementTiles {
            textureTransform TextureTransform {
              scale 4.2 5.6
            }
          }
          geometry Plane {
            size 4.2 5.6
          }
        }
      ]
      name "garage_floor"
      boundingObject Plane {
        size 4.2 5.6
      }
    }
    # Front Entrance & Driveway Forecourt (x=0 to 4.2, y=-5.6 to -9.6)
    Solid {
      translation 2.1 -7.6 0
      children [
        Shape {
          appearance Pavement {
            type "slate"
            textureTransform TextureTransform {
              scale 4.2 4.0
            }
          }
          geometry Plane {
            size 4.2 4.0
          }
        }
      ]
      name "entrance_forecourt"
      boundingObject Plane {
        size 4.2 4.0
      }
    }
    # Garage North Wall
    Wall {
      translation 2.1 0 0
      rotation 0 0 1 1.5708
      name "garage_wall_north"
      size 0.3 4.2 2.4
    }
    # Garage East Wall
    Wall {
      translation 4.2 -2.8 0
      name "garage_wall_east"
      size 0.3 5.6 2.4
    }
    # Low Architectural Courtyard East Wall
    Wall {
      translation 4.2 -7.6 0
      name "courtyard_low_wall_east"
      size 0.25 4.0 1.1
    }
  ]
}

