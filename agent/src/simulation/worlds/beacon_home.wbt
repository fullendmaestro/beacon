WorldInfo {
  info [
    "Refined Smart Home with Clean Cutaway Roof, Attached Garage & Entrance Courtyard, Motorized Blinds, Gates, Doors, HVAC, Autonomous Mobile Robot, and Multi-Sensor Automation"
  ]
  title "Beacon Smart Home Estate & IoT Simulation"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "InteriorWheelMat"
      coulombFriction [
        0, 2, 0
      ]
      frictionRotation -0.785398 0
      bounce 0
      forceDependentSlip [
        10, 0
      ]
    }
    ContactProperties {
      material1 "ExteriorWheelMat"
      coulombFriction [
        0, 2, 0
      ]
      frictionRotation 0.785398 0
      bounce 0
      forceDependentSlip [
        10, 0
      ]
    }
  ]
}
