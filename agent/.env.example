# LLM Provider Selection ("bedrock" for Amazon Bedrock Nova/Claude or "gemini" for Google Gemini)
BEACON_LLM_PROVIDER=gemini

# Amazon Bedrock Configuration (Amazon App Dev 2026 - Alexa+ Track)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
AWS_REGION=us-east-1

# Google Gemini / Vertex AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
BEACON_AGENT_MODEL=gemini-2.5-flash

# Smart Home Hub & TIAGo Controller URLs
SMART_HOME_HUB_URL=http://127.0.0.1:8000
TIAGO_API_URL=http://127.0.0.1:8001

# Optional but recommended for tracing.
LANGSMITH_API_KEY=lsv2_...
